      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam handwritten false\nskinparam classAttributeIconSize 0\nskinparam backgroundColor #FFFFFF\nskinparam roundcorner 4\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam defaultFontSize 12\n\n&#39; --- ESTILOS VISUALES (Tono Morado/Azul) ---\nskinparam class {\n    BackgroundColor #E1D5E7\n    BorderColor #9673A6\n    HeaderBackgroundColor #E1D5E7\n}\n\nskinparam class&lt;&lt;Repository&gt;&gt; {\n    BackgroundColor #E1D5E7\n    BorderColor #9673A6\n}\n\n&#39; --- CLASES Y SUS ATRIBUTOS / MÉTODOS ---\n\nclass Persona {\n    - String idPersona\n    - String dni\n    - String nombres\n    - String apellidos\n    - Date fechaNacimiento\n    - String telefono\n    --\n    + getNombreCompleto(): String\n}\n\nclass Paciente {\n    - String numeroHistoriaClinica\n    - String tipoSeguro\n    --\n    + solicitarCita(): void\n    + consultarHistorial(): List\n}\n\nclass Medico {\n    - String cmp\n    - String especialidad\n    --\n    + atenderCita(): void\n    + emitirReceta(): void\n}\n\nclass CitaMedica #DAE8FC-#6C8EBF {\n    - String idCita\n    - DateTime fechaHora\n    - EstadoCita estado\n    - String motivoConsulta\n    --\n    + programarCita(): void\n    + cancelarCita(): void\n    + registrarAtencion(): AtencionMedica\n}\n\nclass AtencionMedica {\n    - String idAtencion\n    - DateTime fechaAtencion\n    - String diagnostico\n    - String tratamiento\n    --\n    + agregarDetalleReceta(): void\n    + generarInforme(): String\n}\n\nclass DetalleReceta {\n    - int cantidad\n    - String indicaciones\n    --\n    + validarStock(): boolean\n}\n\nclass Medicamento {\n    - String idMedicamento\n    - String nombre\n    - int stockDisponible\n    - Date fechaVencimiento\n    --\n    + actualizarStock(int cant): void\n    + estaVencido(): boolean\n}\n\nclass RegistroAtencionBD &lt;&lt;Repository&gt;&gt; {\n    - String conexionBD\n    --\n    + guardarAtencion(AtencionMedica atencion): boolean\n    + buscarPorPaciente(String dni): List\n    + generarReporteMinsa(): File\n}\n\n&#39; --- RELACIONES CON ETIQUETAS Y CARDINALIDADES ---\n\n&#39; Herencia de Persona\nPersona &lt;|-- Paciente : Herencia\nPersona &lt;|-- Medico : Herencia\n\n&#39; Relaciones con CitaMedica\nPaciente \&quot;1\&quot; -- \&quot;0..*\&quot; CitaMedica : Solicita &gt;\nMedico \&quot;1\&quot; -- \&quot;0..*\&quot; CitaMedica : Atiende &gt;\n\n&#39; Composición Cita -&gt; AtencionMedica\nCitaMedica \&quot;1\&quot; *-- \&quot;0..1\&quot; AtencionMedica : Genera &gt;\n\n&#39; Composición AtencionMedica -&gt; DetalleReceta\nAtencionMedica \&quot;1\&quot; *-- \&quot;0..*\&quot; DetalleReceta : Contiene &gt;\n\n&#39; Persistencia a Repositorio\nAtencionMedica --&gt; RegistroAtencionBD : Persiste en &gt;\n\n&#39; Detalle -&gt; Medicamento\nDetalleReceta \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Medicamento : Prescribe &gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="bIhkTQH4g4XP4VSHgm4v-1">
